# =============================================================================
# Keddy WhatsApp AI Assistant — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` file to version control.
# =============================================================================

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --- Groq (AI responses, voice transcription) ---
GROQ_API_KEY=your_groq_api_key

# --- Vision / Image understanding (uses Groq by default) ---
# Model used for image analysis. Defaults to Groq's vision model.
VISION_MODEL=llama-3.2-11b-vision-preview
# Optional: override the vision API key. If unset, falls back to GROQ_API_KEY.
VISION_API_KEY=
# Optional: set a generic OpenAI-style vision endpoint (e.g. for another provider).
# If set, image analysis uses this endpoint instead of the Groq SDK.
VISION_API_URL=
# Optional tuning for the vision request.
VISION_TIMEOUT_SECONDS=60
VISION_MAX_TOKENS=600
VISION_TEMPERATURE=0.22

# --- Server ---
# Public base URL used in privacy/terms links (required in production).
BASE_URL=https://your-deployed-url.com
# Port (default 5000)
PORT=5000
